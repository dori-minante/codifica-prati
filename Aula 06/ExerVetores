
// Contagem de números pares: usar o laço for para contar quantos números pares existem em um array de números.

let numeros = [1, 5, 4, 8, 3, 10];
let quantidadePares = 0;

for (let pos = 0; pos < numeros.length; pos++) {
  if (numeros[pos] % 2 === 0) {
    quantidadePares++;
  }
}

console.log(`A quantidade de números pares é: ${quantidadePares}`);


